{% extends "base.html.twig" %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center bg-gray-100 px-4">
    <div class="flex w-full max-w-4xl bg-white rounded-lg shadow-lg overflow-hidden">
        <!-- Section Image -->
        <div class="hidden md:flex md:w-1/2 bg-gray-100">
            <img src="/img/slides/img-7.jpeg" alt="Réinitialisation de mot de passe" class="w-full h-full object-cover">
        </div>

        <!-- Section Formulaire -->
        <div class="w-full md:w-1/2 p-8">
            <h1 class="text-2xl font-semibold text-gray-800 text-center">
                🔑 Réinitialisation du mot de passe
            </h1>

            <p class="text-gray-600 text-center mt-2">
                Saisissez votre nouveau mot de passe ci-dessous.
            </p>

            {{ form_start(PassForm, {'attr': {'class': 'mt-6 space-y-6'}}) }}
                <div>
                    <label for="{{ PassForm.password.vars.id }}" class="block text-gray-700 font-medium mb-2">
                        Nouveau mot de passe
                    </label>
                    {{ form_widget(PassForm.password, {'attr': {
                        'class': 'block w-full rounded-lg border border-gray-300 px-4 py-3 leading-6 outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 ease-in-out'
                    }}) }}
                    {{ form_errors(PassForm.password, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>

                <button type="submit" class="w-full px-6 py-3 bg-blue-600 text-white font-medium text-lg rounded-lg shadow-md hover:bg-blue-700 focus:ring-2 focus:ring-blue-400 transition duration-150 ease-in-out">
                    🔄 Réinitialiser mon mot de passe
                </button>
            {{ form_end(PassForm) }}

            <div class="text-center mt-6">
                <a href="{{ path('app_login') }}" class="text-blue-600 hover:underline text-sm">
                    🔙 Retour à la connexion
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
