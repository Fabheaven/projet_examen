<div class="mx-3 mt-6 flex flex-col rounded-lg bg-white text-surface shadow-secondary-1 dark:bg-surface-dark dark:text-white sm:shrink-0 sm:grow sm:basis-0">
    <a href="{{ path('app_articles_showCircuit', {slug: circuit.slug}) }}">
        {% if circuit.mediafile %}
            <img class="rounded-t-lg w-full h-48 object-cover"
                 src="{{ vich_uploader_asset(circuit.mediafile, 'mediaFile') }}"
                 alt="{{ circuit.mediafile.imageName }}">
        {% else %}
            <img class="rounded-t-lg w-full h-48 object-cover"
                 src="https://tecdn.b-cdn.net/img/new/standard/city/041.webp"
                 alt="Default image">
        {% endif %}
    </a>
    <div class="p-6">
        <h5 class="mb-2 text-xl font-medium leading-tight">{{ circuit.name }}</h5>
        <p class="mb-4 text-base">{{ circuit.description | slice(0, 100) ~ '...' }}</p>
    </div>
    <div class="mt-auto border-t-2 border-neutral-100 px-6 py-3 text-center text-surface/75 dark:border-white/10 dark:text-neutral-300">
        <p>Mis à jour le : {{ circuit.updatedAt|date('d/m/Y') }}</p>
    </div>
</div>