{% extends "base.html.twig" %}

{% block title %}Inscription{% endblock %}

{% block body %}
	<div class="flex justify-center items-center flex-wrap h-full g-6 text-gray-800 m-24">
		<div class="grow-0 shrink-1 md:shrink-0 basis-auto xl:w-6/12 lg:w-6/12 md:w-9/12 mb-12 md:mb-0">
			<img src="/img/slides/img-7.jpeg" class="w-fit" alt="Illustration"/>
		</div>
		<div class="md:w-8/12 lg:w-5/12 lg:ml-20">
			<h1 class="text-2xl font-semibold text-center mb-6">S'inscrire</h1>

			<!-- Affichage des erreurs -->
			{% if form_errors(registrationForm) %}
				<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
					{{ form_errors(registrationForm) }}
				</div>
			{% endif %}

			{{ form_start(registrationForm) }}
				<!-- Nom de famille -->
				<div class="mb-4">
					<label for="{{ registrationForm.last_name.vars.id }}" class="block text-sm font-medium text-gray-700">Nom de famille</label>
					{{ form_widget(registrationForm.last_name, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
				</div>

				<!-- Prénom -->
				<div class="mb-4">
					<label for="{{ registrationForm.first_name.vars.id }}" class="block text-sm font-medium text-gray-700">Prénom</label>
					{{ form_widget(registrationForm.first_name, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
				</div>

				<!-- Email -->
				<div class="mb-4">
					<label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-gray-700">Email</label>
					{{ form_widget(registrationForm.email, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
				</div>

				<!-- Mot de passe -->
				<div class="mb-4">
					<label for="{{ registrationForm.password.first.vars.id }}" class="block text-sm font-medium text-gray-700">Mot de passe</label>
					{{ form_widget(registrationForm.password.first, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500', 'id': 'password' } }) }}

					<!-- Indicateur de sécurité -->
					<div class="relative mt-2">
						<div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
							<div id="password-strength-bar" class="h-2.5 rounded-full transition-all duration-300"></div>
						</div>
						<p id="password-strength-text" class="text-sm mt-1"></p>
					</div>
				</div>

				<!-- Confirmation du mot de passe -->
				<div class="mb-4">
					<label for="{{ registrationForm.password.second.vars.id }}" class="block text-sm font-medium text-gray-700">Confirmez le mot de passe</label>
					{{ form_widget(registrationForm.password.second, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
				</div>

				<!-- Accepter les conditions -->
				<div class="mb-4 flex items-center">
					{{ form_widget(registrationForm.agreeTerms, { 'attr': { 'class': 'h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500' } }) }}
					<label for="{{ registrationForm.agreeTerms.vars.id }}" class="ml-2 text-sm text-gray-600">J'accepte les conditions générales</label>
				</div>

				<!-- Bouton Soumettre -->
				<button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white font-medium text-lg rounded shadow-md hover:bg-blue-700 transition duration-150 ease-in-out">
					S'inscrire
				</button>
			{{ form_end(registrationForm) }}

			<!-- Lien vers la connexion -->
			<div class="text-center mt-4">
				<p>Déjà inscrit(e) ? <a href="{{ path('app_login') }}" class="text-blue-600 hover:underline">Me connecter</a></p>
			</div>
		</div>
	</div>
{% endblock %}