<div id="carouselExampleCaptions" class="relative" data-twe-carousel-init data-twe-ride="carousel">
  <!-- Carousel indicators -->
  <div class="absolute bottom-0 left-0 right-0 z-[2] mx-[15%] mb-4 flex list-none justify-center p-0" data-twe-carousel-indicators>
    <button type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide-to="0" data-twe-carousel-active class="mx-[3px] h-[3px] w-[30px] cursor-pointer bg-white opacity-20 transition-opacity duration-600ms"></button>
    <button type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide-to="1" class="mx-[3px] h-[3px] w-[30px] cursor-pointer bg-white opacity-20 transition-opacity duration-600ms"></button>
    <button type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide-to="2" class="mx-[3px] h-[3px] w-[30px] cursor-pointer bg-white opacity-20 transition-opacity duration-600ms"></button>
    <button type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide-to="3" class="mx-[3px] h-[3px] w-[30px] cursor-pointer bg-white opacity-20 transition-opacity duration-600ms"></button>
    <button type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide-to="4" class="mx-[3px] h-[3px] w-[30px] cursor-pointer bg-white opacity-20 transition-opacity duration-600ms"></button>
    <button type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide-to="5" class="mx-[3px] h-[3px] w-[30px] cursor-pointer bg-white opacity-20 transition-opacity duration-600ms"></button>
  </div>

  <!-- Carousel items -->
  <div class="relative w-full overflow-hidden">
    <!-- Slide 1 -->
    <div class="relative float-left w-full transition-transform duration-600ms ease-in-out" data-twe-carousel-item>
      <img src="/img/slides/img-1.jpg" class="block w-full h-[300px] md:h-[450px] lg:h-[595px] object-cover" alt="Slide 1">
      <div class="absolute inset-x-[15%] bottom-5 hidden py-5 text-center text-white md:block">
        <h5 class="text-xl"></h5>
        <p></p>
      </div>
    </div>
    <!-- Slide 2 -->
    <div class="relative float-left w-full transition-transform duration-600ms ease-in-out hidden" data-twe-carousel-item>
      <img src="/img/slides/img-2.jpg" class="block w-full h-[300px] md:h-[450px] lg:h-[595px] object-cover" alt="Slide 2">
    </div>
    <!-- Slide 3 -->
    <div class="relative float-left w-full transition-transform duration-600ms ease-in-out hidden" data-twe-carousel-item>
      <img src="/img/slides/img-3.jpg" class="block w-full h-[300px] md:h-[450px] lg:h-[595px] object-cover" alt="Slide 3">
    </div>
    <!-- Slide 4 -->
    <div class="relative float-left w-full transition-transform duration-600ms ease-in-out hidden" data-twe-carousel-item>
      <img src="/img/slides/img-4.jpg" class="block w-full h-[300px] md:h-[450px] lg:h-[595px] object-cover" alt="Slide 4">
    </div>
    <!-- Slide 5 -->
    <div class="relative float-left w-full transition-transform duration-600ms ease-in-out hidden" data-twe-carousel-item>
      <img src="/img/slides/img-5.jpg" class="block w-full h-[300px] md:h-[450px] lg:h-[595px] object-cover" alt="Slide 5">
    </div>
    <!-- Slide 6 -->
    <div class="relative float-left w-full transition-transform duration-600ms ease-in-out hidden" data-twe-carousel-item>
      <img src="/img/slides/img-6.jpg" class="block w-full h-[300px] md:h-[450px] lg:h-[595px] object-cover" alt="Slide 6">
    </div>
  </div>

  <!-- Carousel controls -->
  <button class="absolute bottom-0 left-0 top-0 z-[1] flex items-center justify-center opacity-50 hover:opacity-90" type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide="prev">
    <span class="h-8 w-8">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
      </svg>
    </span>
  </button>
  <button class="absolute bottom-0 right-0 top-0 z-[1] flex items-center justify-center opacity-50 hover:opacity-90" type="button" data-twe-target="#carouselExampleCaptions" data-twe-slide="next">
    <span class="h-8 w-8">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
      </svg>
    </span>
  </button>
</div>