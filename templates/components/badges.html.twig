{% if badges %}
    <div class="flex space-x-2 justify-start mr-2">
        {% for badge in badges %}
            {% if badge.slug is not empty %}
                <span class="text-xs inline-block py-1 px-2.5 leading-none text-center whitespace-nowrap align-baseline font-bold bg-blue-600 text-white rounded-full">
                    <a href="{{ path('category.index', {slug: badge.slug}) }}">{{ badge.name }}</a>
                </span>
            {% else %}
                <span class="text-xs inline-block py-1 px-2.5 leading-none text-center whitespace-nowrap align-baseline font-bold bg-gray-400 text-white rounded-full">
                    {{ badge.name }}
                </span>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
