{% extends "base.html.twig" %}

{% block name %}
    {{ circuit.name }}
{% endblock %}

{% block body %}
    <div class="container mx-auto">
        <h1 class="text-5xl text-center mt-8 mb-4 text-blue-700 font-bold">
            {{ circuit.name|capitalize }}!
        </h1>
        <h2 class="text-2xl text-center mb-8">Publié le
            {{ circuit.createdAt|date('d/m/Y') }}</h2>

        <div class="sm:flex sm:justify-center">
            <div class="flex flex-col rounded-lg bg-white text-surface shadow-secondary-1 dark:bg-surface-dark dark:text-white sm:shrink-0 sm:grow sm:basis-0 sm:rounded-e-none">
                <a href="{{ path('app_circuits_showCircuit', {'slug': circuit.slug}) }}">
                    {% if circuit.mediafile %}
                        <img
                            class="rounded-t-lg sm:rounded-tr-none"
                            src="{{ vich_uploader_asset(circuit.mediafile, 'mediaFile') }}"
                            alt="{{ circuit.mediafile.imageName }}" />
                    {% else %}
                        <img
                            class="rounded-t-lg sm:rounded-tr-none"
                            src="https://tecdn.b-cdn.net/img/new/standard/city/041.webp"
                            alt="Default image" />
                    {% endif %}
                </a>
                <div class="w-2/3 mx-auto my-8 leading-6">
                    {% include "components/badges.html.twig" with { badges: circuit.categories } only %}
                </div>
                <div class="p-6">
                    <h5 class="mb-2 text-xl font-medium leading-tight">{{ circuit.name }}</h5>
                    <p class="mb-4 text-base">{{ circuit.description|raw }}</p>  {# Utilisation de raw si la description contient du HTML #}
                    <p class="mb-4 text-base text-surface/75 dark:text-neutral-300">
                        <small>Dernière mise à jour: {{ circuit.updatedAt|date('d/m/Y') }}</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
