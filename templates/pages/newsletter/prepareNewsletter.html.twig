{% extends "base.html.twig" %}

{% block title %}Création de Newsletter{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="display-4 text-center mb-4">Créez votre Newsletter</h1>
        <p class="lead text-center mb-5">
            Utilisez notre formulaire ci-dessous pour rédiger et personnaliser votre prochaine newsletter. Un excellent moyen d'engager votre audience et de les tenir informés des dernières nouvelles.
        </p>

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 col-sm-12">
                {{ form_start(form) }}
                    <div class="form-group">
                        <label for="name" class="font-weight-bold">Nom de la Newsletter</label>
                        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le nom de la newsletter'}}) }}
                    </div>

                    <div class="form-group">
                        <label for="content" class="font-weight-bold">Contenu de la Newsletter</label>
                        {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows': '6', 'placeholder': 'Rédigez le contenu de la newsletter ici'}}) }}
                    </div>

                    <div class="form-group">
                        <label for="categories" class="font-weight-bold">Catégories</label>
                        {{ form_widget(form.categories, {'attr': {'class': 'form-control'}}) }}
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        {% if app.flashes('success') %}
            <div class="alert alert-success mt-4">
                <p>La newsletter a été créée avec succès. Vous pouvez maintenant l'envoyer à vos abonnés !</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
