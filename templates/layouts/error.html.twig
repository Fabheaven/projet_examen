<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Diosso Tourisme - Erreur {{ exception.statusCode }}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
  {{ encore_entry_link_tags('app') }}
  {{ encore_entry_script_tags('app') }}
  <style>
    /* Empêcher le défilement horizontal et vertical */
    html, body {
      height: 100%;
      margin: 0; /* Éviter un margin par défaut */
      overflow: hidden; /* Empêche les barres de défilement */
    }
    .container {
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
    }
    .flex {
      display: flex;
    }
    .items-center {
      align-items: center;
    }
    .justify-center {
      justify-content: center;
    }
    .w-full {
      width: 100%;
    }
    .h-screen {
      height: 100vh; /* Utilise la hauteur de la fenêtre */
    }
  </style>
</head>
<body>
  <div
    class="
      flex
      items-center
      justify-center
      w-full
      h-screen
      bg-gradient-to-r
      from-white-600
      to-blue-400
    "
  >
    <div class="container flex flex-col items-center">
      <h1 class="font-bold text-blue-600 text-6xl sm:text-7xl md:text-9xl">
        HTTP Error {{ exception.statusCode }}
      </h1>

      <p class="my-2 text-xl sm:text-2xl font-bold text-center text-gray-800 md:text-3xl">
        {{ exception.statusText }}
      </p>

      <a
        href="/"
        class="px-6 py-2 mt-6 text-sm sm:text-base font-semibold text-blue-800 bg-blue-100"
      >
        Retourner à l'accueil
      </a>
    </div>
  </div>
</body>
</html>
