{% extends 'base.html.twig' %}

{% block title %}Abonnement à la Newsletter{% endblock %}

{% block body %}
<div class="h-full bg-gray-400 dark:bg-gray-900 flex justify-center items-center py-12">
    <div class="w-full max-w-3xl">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8">
            <h1 class="text-2xl font-bold text-center text-gray-800 dark:text-white mb-4">Abonnez-vous à notre Newsletter</h1>
            <p class="text-center text-gray-600 dark:text-gray-300 mb-6">
                Restez informé des dernières actualités, conseils et offres exclusives. 
                Choisissez les thématiques qui vous intéressent et recevez des contenus personnalisés.
            </p>
            
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_label(form.email, 'Adresse e-mail', {'label_attr': {'class': 'block text-sm font-bold text-gray-700 dark:text-white'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'w-full px-3 py-2 text-sm text-gray-700 dark:text-white border rounded shadow focus:outline-none focus:ring focus:ring-blue-500', 'placeholder': 'exemple@domaine.com'}}) }}
                    <div class="text-red-500 text-xs mt-1">
                        {{ form_errors(form.email) }}
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-bold text-gray-700 dark:text-white">Sélectionnez les catégories qui vous intéressent :</label>
                    <div class="space-y-2">
                        {{ form_widget(form.categories, {'attr': {'class': 'form-check-input'}}) }}
                    </div>
                </div>
                
                <div class="flex items-center">
                    {{ form_widget(form.isRgpd, {'attr': {'class': 'mr-2'}}) }}
                    {{ form_label(form.isRgpd, null, {'label_attr': {'class': 'text-sm text-gray-700 dark:text-white'}}) }}
                </div>
                <div class="text-red-500 text-xs mt-1">
                    {{ form_errors(form.isRgpd) }}
                </div>
                
                <div>
                    {{ form_widget(form.submit, {'attr': {'class': 'w-full bg-blue-500 dark:bg-blue-700 text-white font-bold py-2 px-4 rounded hover:bg-blue-700 dark:hover:bg-blue-900 focus:outline-none'}}) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
