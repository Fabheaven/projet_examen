{% extends 'base.html.twig' %}

{% block title %}{{ circuit.name }}{% endblock %}

{% block body %}
<div class="container mx-auto">
    <h1 class="text-5xl font-bold text-center mt-24 mb-8">{{ circuit.name }}</h1>

    <!-- Affichage d'une seule carte centrée -->
    <div class="flex justify-center mt-8">
        <div class="block w-full max-w-3xl rounded-lg bg-white shadow-lg dark:bg-gray-800">
            <div class="relative overflow-hidden bg-cover bg-no-repeat">
                {% if circuit.mediafile %}
                    <img class="rounded-t-lg w-full h-72 object-cover"
                         src="{{ vich_uploader_asset(circuit.mediafile, 'mediaFile') }}"
                         alt="{{ circuit.mediafile.imageName }}">
                {% else %}
                    <img class="rounded-t-lg w-full h-72 object-cover"
                         src="https://tecdn.b-cdn.net/img/new/standard/city/041.webp"
                         alt="Default image">
                {% endif %}
            </div>

            <div class="p-6 text-gray-900 dark:text-white">
                <h5 class="mb-2 text-xl font-medium leading-tight font-bold text-center">{{ circuit.name }}</h5>
                <div class="mb-4">
                    {% for badge in circuit.categories %}
                        <span class="inline-block py-1 px-3 text-xs font-medium text-blue-600 bg-blue-100 rounded-full mr-2 mb-2">
                            {{ badge.name }}
                        </span>
                    {% endfor %}
                </div>
                <p class="mb-4 text-base text-gray-700 dark:text-gray-300">
                    {{ circuit.description | raw }}
                </p>
                <p class="text-lg font-bold">Prix: {{ circuit.price }} €</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
