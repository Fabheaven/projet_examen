{% extends 'base.html.twig' %}

{% block title %}Diosso Tourisme - Contact{% endblock %}

{% block body %}
     <div class="flex justify-center items-center flex-wrap h-full g-6 text-gray-800 mt-24 bg-cover bg-center" style="background-image: url('{{ asset('img/slides/img-1.jpg') }}');">
        <div class="md:w-8/12 lg:w-6/12 mb-12 md:mb-0">
            <h1 class="text-2xl font-semibold text-center mb-6">Nous contacter</h1>

            <!-- Affichage des messages flash -->
            {% for message in app.flashes('success') %}
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form) }}

                <!-- Nom -->
                <div class="mb-4">
                    <label for="{{ form.first_name.vars.id }}" class="block text-sm font-medium text-gray-700">Nom</label>
                    {{ form_widget(form.first_name, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
                </div>

                <!-- Prénom -->
                <div class="mb-4">
                    <label for="{{ form.last_name.vars.id }}" class="block text-sm font-medium text-gray-700">Prénom</label>
                    {{ form_widget(form.last_name, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
                </div>

                <!-- Email -->
                <div class="mb-4">
                    <label for="{{ form.email.vars.id }}" class="block text-sm font-medium text-gray-700">Email</label>
                    {{ form_widget(form.email, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
                </div>

                <!-- Message -->
                <div class="mb-4">
                    <label for="{{ form.message.vars.id }}" class="block text-sm font-medium text-gray-700">Message</label>
                    {{ form_widget(form.subject, { 'attr': { 'class': 'form-control block w-full px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500' } }) }}
                </div>

                <!-- Ne pas inclure le champ subject ici -->
                {# Ne pas inclure {{ form_widget(form.subject) }} si vous ne voulez pas qu'il apparaisse #}

                <!-- Bouton Soumettre -->
                <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white font-medium text-lg rounded shadow-md hover:bg-blue-700 transition duration-150 ease-in-out">
                    Envoyer
                </button>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
