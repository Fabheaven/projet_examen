{% extends "base.html.twig" %}

{% block name %}
    {{ activity.name }}
{% endblock %}

{% block body %}
    <div class="container mx-auto">
        <h1>{{ activity.name|capitalize }}</h1>
        <div class="sm:flex sm:justify-center">
            <div class="flex flex-col rounded-lg bg-white text-surface shadow-secondary-1 dark:bg-surface-dark dark:text-white sm:shrink-0 sm:grow sm:basis-0 sm:rounded-e-none">
                <a href="{{ path('app_articles_showActivity', {'slug': activity.slug}) }}">
                    {% if activity.mediafile %}
                        <img
                            class="rounded-t-lg sm:rounded-tr-none"
                            src="{{ vich_uploader_asset(activity.mediafile, 'mediaFile') }}"
                            alt="{{ activity.mediafile.imageName }}" />
                    {% else %}
                        <img
                            class="rounded-t-lg sm:rounded-tr-none"
                            src="https://tecdn.b-cdn.net/img/new/standard/city/041.webp"
                            alt="Default image" />
                    {% endif %}
                </a>
                <div class="p-6">
                    <h5 class="mb-2 text-xl font-medium leading-tight">{{ activity.name }}</h5>
                    <p class="mb-4 text-base">{{ activity.description|raw }}</p>  {# Utilisation de raw si la description contient du HTML #}
                    <p class="mb-4 text-base text-surface/75 dark:text-neutral-300">
                        <small>Dernière mise à jour: {{ activity.updatedAt|date('d/m/Y') }}</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
